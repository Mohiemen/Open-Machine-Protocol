{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omp:spec:core:process_run:0.1",
  "title": "OMP process_run body",
  "description": "The genealogy unit. Core Schema Specification v0.1 section 7.3.",
  "type": "object",
  "$defs": {
    "iso_ts": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    }
  },
  "properties": {
    "run_id": {
      "description": "Unique within the machine. SHOULD be globally unique (UUIDv7 recommended).",
      "type": "string",
      "minLength": 1
    },
    "run_type": {
      "description": "batch, job, cycle_group, shift, or profile-defined.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "program_ref": { "type": "string" },
    "start_ts": { "$ref": "#/$defs/iso_ts" },
    "end_ts": { "$ref": "#/$defs/iso_ts" },
    "outcome": { "enum": ["completed", "aborted", "failed", "unknown"] },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "start_ts": { "$ref": "#/$defs/iso_ts" },
          "end_ts": { "$ref": "#/$defs/iso_ts" },
          "params": { "type": "object" }
        },
        "required": ["name", "start_ts", "end_ts"],
        "additionalProperties": false
      }
    },
    "quantities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "value": { "type": "number" },
          "unit": { "type": "string" }
        },
        "required": ["name", "value", "unit"],
        "additionalProperties": false
      }
    },
    "event_seq_range": {
      "description": "The envelope seq range of events belonging to this run - what lets a DPP claim cite its evidence.",
      "type": "object",
      "properties": {
        "first": { "type": "integer", "minimum": 1 },
        "last": { "type": "integer", "minimum": 1 }
      },
      "required": ["first", "last"],
      "additionalProperties": false
    }
  },
  "required": ["run_id", "run_type", "start_ts", "end_ts", "outcome"],
  "patternProperties": { "^x-": { "type": "object" } },
  "additionalProperties": false
}
