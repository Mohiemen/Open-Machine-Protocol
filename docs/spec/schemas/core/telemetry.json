{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omp:spec:core:telemetry:0.1",
  "title": "OMP telemetry body",
  "description": "Continuous sensor data as raw samples or interval statistics. Core Schema Specification v0.1 section 7.5.",
  "type": "object",
  "$defs": {
    "iso_ts": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    }
  },
  "properties": {
    "channel": {
      "description": "Profile-recommended names SHOULD be used.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "unit": {
      "description": "UCUM unit string (Cel, Hz, A).",
      "type": "string",
      "minLength": 1
    },
    "mode": { "enum": ["samples", "stats"] },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "t": { "$ref": "#/$defs/iso_ts" },
          "v": { "type": "number" }
        },
        "required": ["t", "v"],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "stats": {
      "type": "object",
      "properties": {
        "start_ts": { "$ref": "#/$defs/iso_ts" },
        "end_ts": { "$ref": "#/$defs/iso_ts" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "avg": { "type": "number" },
        "count": { "type": "integer", "minimum": 1 }
      },
      "required": ["start_ts", "end_ts", "min", "max", "avg", "count"],
      "additionalProperties": false
    },
    "run_id": { "type": "string" }
  },
  "required": ["channel", "unit", "mode"],
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "samples" } } },
      "then": { "required": ["samples"] }
    },
    {
      "if": { "properties": { "mode": { "const": "stats" } } },
      "then": { "required": ["stats"] }
    }
  ],
  "patternProperties": { "^x-": { "type": "object" } },
  "additionalProperties": false
}
