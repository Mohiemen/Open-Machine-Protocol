{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:omp:spec:core:energy:0.1",
  "title": "OMP energy body",
  "description": "Utility consumption during an interval, never a meter total. Core Schema Specification v0.1 section 7.4.",
  "type": "object",
  "properties": {
    "metric": {
      "description": "kwh, water_l, steam_kg, air_m3, gas_m3, or profile-defined.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "value": {
      "description": "Consumption during the interval. MUST be >= 0.",
      "type": "number",
      "minimum": 0
    },
    "interval": {
      "type": "object",
      "properties": {
        "start_ts": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
        },
        "end_ts": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
        }
      },
      "required": ["start_ts", "end_ts"],
      "additionalProperties": false
    },
    "source": {
      "description": "The honesty ladder - consumers weigh evidence accordingly.",
      "enum": ["native", "ct_clamp", "submeter", "estimated"]
    },
    "run_id": { "type": "string" }
  },
  "required": ["metric", "value", "interval", "source"],
  "patternProperties": { "^x-": { "type": "object" } },
  "additionalProperties": false
}
